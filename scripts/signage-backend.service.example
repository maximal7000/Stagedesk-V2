# /etc/systemd/system/signage-backend.service
# Parallel Signage installation (signage.t410.de).
# Independent from the primary tag-backend.service; own working dir and socket.
[Unit]
Description=Daphne ASGI instance to serve signage (signage.t410.de)
After=network.target postgresql.service redis.service

[Service]
User=root
Group=www-data
WorkingDirectory=/opt/signage/backend
ExecStart=/opt/signage/backend/venv/bin/daphne \
    -u /run/signage.sock \
    core.asgi:application
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
