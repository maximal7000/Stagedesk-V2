# /etc/nginx/sites-available/signage
# Parallel Signage installation (signage.t410.de) — Frontend (Vite build) +
# ASGI backend via Unix socket. Independent from the primary "tag" site.

server {
    server_name signage.t410.de;

    client_max_body_size 100M;

    location /admin/ {
        include proxy_params;
        proxy_pass http://unix:/run/signage.sock;
    }

    location /api/ {
        include proxy_params;
        proxy_pass http://unix:/run/signage.sock;
    }

    # WebSocket (Django Channels)
    location /ws/ {
        proxy_pass http://unix:/run/signage.sock;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    location /django-static/ {
        alias /opt/signage/backend/staticfiles/;
    }

    location /media/ {
        alias /opt/signage/backend/media/;
    }

    # React frontend
    location / {
        root /opt/signage/frontend/dist;
        index index.html;
        try_files $uri /index.html;
    }

    # Current builds emit no .mjs. If a future dependency ships an ES module
    # worker (e.g. pdf.js), add an ".mjs" location that serves it as
    # application/javascript, mirroring nginx-stagedesk.conf.example.

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/signage.t410.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/signage.t410.de/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = signage.t410.de) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    server_name signage.t410.de;
    return 404;
}
