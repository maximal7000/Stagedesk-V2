[Unit]
Description=Stagedesk Kiosk (cage und Chromium)
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
WorkingDirectory=/home/pi
# KIOSK_URL schreibt der Agent; die Datei gehört root und hat Modus 600, systemd liest sie vor dem Benutzerwechsel.
EnvironmentFile=/etc/stagedesk-agent/kiosk.env
Environment=XCURSOR_THEME=blank
Environment=XCURSOR_PATH=/home/pi/.icons
ExecStart=/usr/bin/cage -s -- /opt/stagedesk-agent/kiosk/kiosk.sh
Restart=always
RestartSec=5
SyslogIdentifier=stagedesk-kiosk

[Install]
WantedBy=multi-user.target
